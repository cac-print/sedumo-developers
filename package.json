{
	"name": "sedumo-developers",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"guides": "node scripts/guides.mjs",
		"dev": "node scripts/skill.mjs && vite dev",
		"build": "node scripts/skill.mjs && vite build && node scripts/search-index.mjs && vite build",
		"build:cloudflare": "SEDUMO_ADAPTER=cloudflare npm run build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"setup": "node setup/setup.mjs"
	},
	"devDependencies": {
		"@fontsource/bricolage-grotesque": "^5.3.0",
		"@sveltejs/adapter-cloudflare": "^9.0.0",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"fflate": "^0.8.3",
		"marked": "^18.2.1",
		"marked-gfm-heading-id": "^4.1.4",
		"pagefind": "^1.6.0",
		"pdf-lib": "^1.17.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"wrangler": "^4.166.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd": false
	}
}
